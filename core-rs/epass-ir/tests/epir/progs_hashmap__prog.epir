; ePass IR v1

bb0: ; preds=[] succs=[bb1,bb2]
  storeraw.u32 [%sp-4+sp], 1:i32
  %0 = add64 %sp, -4:i32
  %1 = loadimm.imm64 0
  %2 = call #1(%1, %0)
  jeq64 %2, 0:i32 -> bb2 else bb1

bb1: ; preds=[bb0] succs=[bb3]
  %3 = loadraw.u64 [%2+0]
  %4 = add64 %3, 1:i32
  storeraw.u64 [%2+0], %4
  %5 = loadraw.u32 [%sp-4+sp]
  %6 = loadimm.imm64 0
  %7 = call #6(%6, %5, %4)
  ja bb3

bb2: ; preds=[bb0] succs=[bb3]
  storeraw.u64 [%sp-16+sp], 1:i32
  %8 = add64 %sp, -4:i32
  %9 = add64 %sp, -16:i32
  %10 = loadimm.imm64 0
  %11 = call #2(%10, %8, %9, 0:i32)
  %12 = loadraw.u32 [%sp-4+sp]
  %13 = loadimm.imm64 24
  %14 = call #6(%13, %12, %9, 0:i32)

bb3: ; preds=[bb1,bb2] succs=[]
  ret 2:i32

