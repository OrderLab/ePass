  storeraw.u8 [%9+0], 44:i32
  %10 = add32 %7, 1:i32
  storeraw.u32 [%2+0], %10
  jeq32 %7, 99:i32 -> bb5 else bb4

bb4: ; preds=[bb3] succs=[bb5]
  %11 = add64 %8, %10
  storeraw.u8 [%11+0], 44:i32
  %12 = add32 %7, 2:i32
  storeraw.u32 [%2+0], %12

bb5: ; preds=[bb1,bb2,bb3,bb4] succs=[]
