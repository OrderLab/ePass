  %3 = add64 %sp, -1:i32
  %4 = add64 %sp, -108:i32
  %5 = loadimm.imm64 0
  %6 = call #2(%5, %3, %4, 1:i32)
  ja bb5

bb2: ; preds=[bb0] succs=[bb3,bb5]
  %7 = loadraw.u32 [%2+0]
  jgt32 %7, 99:i32 -> bb5 else bb3

bb3: ; preds=[bb2] succs=[bb4,bb5]
  %8 = add64 %2, 4:i32
