; ePass IR v1

bb0: ; preds=[] succs=[bb1]
  %0 = loadimm.imm64 0
  %1 = call #5()

bb1: ; preds=[bb0,bb2] succs=[bb2,bb3]
  %2 = phi [%2, bb2], [%1, bb0]
  %3 = phi [%4, bb2], [0:i32, bb0]
  %5 = phi [%6, bb2], [%0, bb0]
  storeraw.u32 [%5+0], %3
  %6 = add64 %5, 4:i32
  %4 = add64 %3, 1:i32
  jeq64 %4, 100:i32 -> bb3 else bb2

bb2: ; preds=[bb1] succs=[bb1]
  ja bb1

bb3: ; preds=[bb1] succs=[]
  %7 = mod64 %2, 100:i32
  %8 = lsh64 %7, 2:i32
  %9 = loadimm.imm64 0
  %10 = add64 %9, %8
  %11 = loadraw.u32 [%10+0]
  %12 = loadimm.imm64 0
  %13 = call #6(%12, 9:i32, %11)
  ret 0:i32

