; ePass IR v1

bb0: ; preds=[] succs=[bb1,bb4]
  %0 = loadraw.u64 [%arg0+8]
  jne32 %0, 0:i32 -> bb4 else bb1

bb1: ; preds=[bb0] succs=[bb2,bb4]
  %1 = call #15()
  %2 = lsh64 %1, 32:i32
  %3 = rsh64 %2, 32:i32
  storeraw.u64 [%sp-8+sp], %3
  %4 = add64 %sp, -8:i32
  %5 = loadimm.imm64 0
  %6 = call #1(%5, %4)
  jeq64 %6, 0:i32 -> bb4 else bb2

bb2: ; preds=[bb1] succs=[bb3,bb4]
  %7 = loadraw.u8 [%6+0]
  jne32 %7, 1:i32 -> bb4 else bb3

bb3: ; preds=[bb2] succs=[bb4]
  %8 = loadraw.u64 [%sp-8+sp]
  %9 = loadimm.imm64 0
  %10 = call #6(%9, 24:i32, %8)

bb4: ; preds=[bb0,bb1,bb2,bb3] succs=[]
  %11 = phi [%0, bb0], [0:i32, bb1], [0:i32, bb2], [-1:i32, bb3]
  ret %11

