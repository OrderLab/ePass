; ePass IR v1

bb0: ; preds=[] succs=[bb1]

bb1: ; preds=[bb0,bb2] succs=[bb2,bb3]
  %0 = phi [%1, bb2], [0:i32, bb0]
  jeq64 %0, 10000:i32 -> bb3 else bb2

bb2: ; preds=[bb1] succs=[bb3,bb1]
  %2 = call #5()
  %1 = add64 %0, 1:i32
  %3 = call #5()
  jle64 %2, %3 -> bb1 else bb3

bb3: ; preds=[bb1,bb2] succs=[]
  %4 = phi [%0, bb1], [%0, bb2]
  %5 = loadimm.imm64 0
  %6 = call #6(%5, 14:i32, %4)
  ret 2:i32

