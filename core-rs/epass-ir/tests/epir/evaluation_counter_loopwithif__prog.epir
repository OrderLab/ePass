; ePass IR v1

bb0: ; preds=[] succs=[bb1,bb5]
  %0 = call #5()
  %1 = mod64 %0, 10:i32
  jlt64 %1, 6:i32 -> bb5 else bb1

bb1: ; preds=[bb0] succs=[bb2]

bb2: ; preds=[bb1,bb3] succs=[bb3,bb9]
  %2 = phi [%2, bb3], [%1, bb1]
  %3 = phi [%4, bb3], [0:i32, bb1]
  %5 = call #5()
  %4 = add32 %3, 1:i32
  jge32 %4, %2 -> bb9 else bb3

bb3: ; preds=[bb2] succs=[bb4,bb2]
  jlt32 %3, 5000:i32 -> bb2 else bb4

bb4: ; preds=[bb3] succs=[bb9]
  ja bb9

bb5: ; preds=[bb0] succs=[bb6,bb9]
  %6 = call #5()
  jeq64 %6, 0:i32 -> bb9 else bb6

bb6: ; preds=[bb5] succs=[bb7]

bb7: ; preds=[bb6,bb8] succs=[bb8,bb9]
  %7 = phi [%7, bb8], [%6, bb6]
  %8 = phi [%9, bb8], [0:i32, bb6]
  %10 = call #5()
  %9 = add64 %8, 1:i32
  jle64 %7, %9 -> bb9 else bb8

bb8: ; preds=[bb7] succs=[bb9,bb7]
  jlt64 %8, 5000:i32 -> bb7 else bb9

bb9: ; preds=[bb2,bb4,bb5,bb7,bb8] succs=[]
  ret 0:i32

