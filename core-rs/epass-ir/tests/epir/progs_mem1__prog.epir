; ePass IR v1

bb0: ; preds=[] succs=[bb1,bb2]
  %0 = call #5()
  storeraw.u32 [%sp-4+sp], 9:i32
  storeraw.u32 [%sp-8+sp], 8:i32
  storeraw.u32 [%sp-12+sp], 7:i32
  storeraw.u32 [%sp-16+sp], 6:i32
  storeraw.u32 [%sp-20+sp], 5:i32
  storeraw.u32 [%sp-24+sp], 4:i32
  storeraw.u32 [%sp-28+sp], 3:i32
  storeraw.u32 [%sp-32+sp], 2:i32
  storeraw.u32 [%sp-36+sp], 1:i32
  storeraw.u32 [%sp-40+sp], 0:i32
  %1 = mod64 %0, 20:i32
  jgt64 %1, 10:i32 -> bb2 else bb1

bb1: ; preds=[bb0] succs=[bb2]
